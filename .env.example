# --- Asosiy ---
# Lokal ishlab chiqish (npm run db:local). Docker'da docker-compose.yml buni POSTGRES_* dan oʻzi yasaydi.
# Supabase (Vercel): DATABASE_URL — Transaction pooler (6543-port) + ?pgbouncer=true&connection_limit=1
#                    DIRECT_URL   — Session pooler (5432-port), migratsiyalar uchun
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/advokat"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/advokat"
NEXT_PUBLIC_SITE_URL="https://advokatkerak.uz"
NEXT_PUBLIC_BRAND_NAME="AdvokatKerak"
# openssl rand -base64 32
AUTH_SECRET=""

# --- Aloqa va footer ---
NEXT_PUBLIC_CONTACT_PHONE="+998 71 200 00 00"
NEXT_PUBLIC_CONTACT_EMAIL="info@advokatkerak.uz"
NEXT_PUBLIC_TELEGRAM_BOT="advokatkerak_bot"
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_OPERATOR_INFO="“[Kompaniya nomi]” MChJ, STIR: [—]"

# --- SMS (Eskiz.uz). Bo'sh bo'lsa — mock: kod server logiga yoziladi ---
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# Mock rejimda kodni sahifada ko'rsatish (faqat test uchun! productionda 0)
OTP_DEV_ECHO="0"

# --- Telegram (bot token bo'lmasa — mock) ---
TELEGRAM_BOT_TOKEN=""
# Admin signallari yuboriladigan chat/guruh ID
TELEGRAM_ADMIN_CHAT_ID=""
# Bot jarayoni (bot/): webhook | polling (lokal uchun: npm run bot:dev)
BOT_MODE="webhook"
BOT_PORT="8081"
BOT_WEBHOOK_PATH="/telegram/webhook"
# Tashqi manzil (https), ko'rsatilsa bot ishga tushganda webhook avtomatik o'rnatiladi
BOT_WEBHOOK_URL=""
# openssl rand -hex 32 — Telegram har so'rovda shu tokenni yuboradi
TELEGRAM_WEBHOOK_SECRET=""

# --- Cloudflare Turnstile (bo'sh bo'lsa — o'chirilgan) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Fayl xotirasi: S3-mos (bo'sh bo'lsa — ./storage papkasi; Vercel'da MAJBURIY) ---
# Supabase Storage: S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3, S3_REGION=<loyiha regioni>,
# kalitlar: Storage → Settings → S3 Access Keys. S3_BUCKET — yopiq (hujjatlar), S3_PUBLIC_BUCKET — ochiq (avatarlar)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Ochiq fayllar uchun alohida bucket (ixtiyoriy; boʻsh boʻlsa S3_BUCKET)
S3_PUBLIC_BUCKET=""
# Ochiq bucket URL, Supabase: https://<ref>.supabase.co/storage/v1/object/public/<S3_PUBLIC_BUCKET>
S3_PUBLIC_URL=""
LOCAL_STORAGE_DIR="./storage"

# --- Davriy vazifa (murojaatlarni qayta yuborish) ---
# Bir nechta instans bo'lsa 0 qiling va /api/cron/dispatch ni tashqi cron bilan chaqiring
ENABLE_INTERNAL_CRON="1"
CRON_SECRET=""

# --- Toʻlovlar: Payme (Merchant API) ---
# Kabinetdagi endpoint: {SITE_URL}/api/payments/payme, hisob maydoni: order_id
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# 1 — test kassasi (checkout.test.paycom.uz)
PAYME_TEST="0"

# --- Toʻlovlar: Click (SHOP API) ---
# Prepare: {SITE_URL}/api/payments/click/prepare, Complete: {SITE_URL}/api/payments/click/complete
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Kalitlar boʻsh boʻlsa — test toʻlov sahifasi (faqat development). Productionda majburan yoqish: 1 (TAVSIYA ETILMAYDI)
PAYMENTS_MOCK="0"

# --- Analitika (boʻsh boʻlsa — yuklanmaydi) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_YM_ID=""

# --- SEO ---
# Staging/test serverda 1 — robots.txt butun saytni yopadi
ROBOTS_NOINDEX="0"

# --- Docker (docker-compose.yml) ---
POSTGRES_USER="advokat"
# openssl rand -hex 24  (URL ichida ishlatiladi — maxsus belgilarsiz)
POSTGRES_PASSWORD=""
POSTGRES_DB="advokat"
WEB_PORT="3000"
# Caddy (--profile proxy) uchun domen, masalan advokatkerak.uz
DOMAIN=""

# --- Boshlangʻich maʼlumotlar (seed) ---
# migrate servisi: 1 — har ishga tushganda migratsiyadan keyin seed ham ishlaydi.
# Odatda bir marta: docker compose run --rm migrate npx prisma db seed
SEED="0"
# Birinchi admin telefon raqami (+998XXXXXXXXX). Shu raqam bilan SMS orqali kiriladi.
ADMIN_PHONE=""
# 1 — test advokatlar va mijozlar ham yaratiladi. PRODUCTIONDA 0!
SEED_DEMO="0"

# --- Vercel ---
# 1 — har production build'da seed ham ishlaydi (birinchi deploy uchun; keyin 0 qilish mumkin)
SEED_ON_BUILD="0"
# 1 — preview deploy'larda ham migratsiya (faqat preview uchun alohida baza boʻlsa!)
MIGRATE_ON_PREVIEW="0"
