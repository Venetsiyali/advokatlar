{
  "name": "advokatkerak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "i18n:cyrl": "tsx scripts/gen-cyrl.ts",
    "bot": "node --conditions=react-server --import tsx bot/src/index.ts",
    "bot:dev": "node --conditions=react-server --env-file=.env --import tsx bot/src/index.ts --polling",
    "bot:simulate": "node --conditions=react-server --env-file=.env --import tsx bot/test/simulate.ts",
    "payments:simulate": "node --conditions=react-server --env-file=.env --import tsx scripts/payments-simulate.ts",
    "test:e2e": "playwright test",
    "start:prod": "node scripts/start-standalone.mjs",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.46.0",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "use-intl": "^4.15.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
